{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "grafana",
    "namespace": "observability"
  },
  "spec": {
    "selector": {
      "matchLabels": {
        "app": "grafana"
      }
    },
    "strategy": {
      "type": "Recreate"
    },
    "template": {
      "metadata": {
        "annotations": {
          "kubectl.kubernetes.io/restartedAt": "2026-11-02T01:45:49-03:00"
        },
        "creationTimestamp": null,
        "labels": {
          "app": "grafana"
        }
      },
      "spec": {
        "containers": [
          {
            "env": [
              {
                "name": "GF_SECURITY_ADMIN_USER",
                "value": "admin"
              },
              {
                "name": "GF_SECURITY_ADMIN_PASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "admin-password",
                    "name": "grafana-admin"
                  }
                }
              },
              {
                "name": "GF_USERS_ALLOW_SIGN_UP",
                "value": "false"
              }
            ],
            "image": "grafana/grafana:11.6.1",
            "imagePullPolicy": "IfNotPresent",
            "name": "grafana",
            "ports": [
              {
                "containerPort": 3000,
                "protocol": "TCP"
              }
            ],
            "readinessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "path": "/api/health",
                "port": 3000,
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 10,
              "periodSeconds": 10,
              "successThreshold": 1,
              "timeoutSeconds": 1
            },
            "resources": {
              "limits": {
                "cpu": "500m",
                "memory": "384Mi"
              },
              "requests": {
                "cpu": "50m",
                "memory": "128Mi"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/etc/grafana/provisioning/dashboards",
                "name": "dashboard-provider",
                "readOnly": true
              },
              {
                "mountPath": "/etc/grafana/provisioning/cloudops-dashboards",
                "name": "cloudops-dashboard",
                "readOnly": true
              },
              {
                "mountPath": "/etc/grafana/provisioning/datasources",
                "name": "datasources"
              },
              {
                "mountPath": "/var/lib/grafana",
                "name": "storage"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {
          "fsGroup": 472
        },
        "terminationGracePeriodSeconds": 30,
        "volumes": [
          {
            "configMap": {
              "defaultMode": 420,
              "name": "grafana-dashboard-provider"
            },
            "name": "dashboard-provider"
          },
          {
            "configMap": {
              "defaultMode": 420,
              "name": "grafana-cloudops-dashboard"
            },
            "name": "cloudops-dashboard"
          },
          {
            "configMap": {
              "defaultMode": 420,
              "name": "grafana-datasources"
            },
            "name": "datasources"
          },
          {
            "name": "storage",
            "persistentVolumeClaim": {
              "claimName": "grafana-storage"
            }
          }
        ],
        "nodeSelector": {
          "kubernetes.io/hostname": "k3d-xp-sre-lab-server-0"
        }
      }
    }
  }
}